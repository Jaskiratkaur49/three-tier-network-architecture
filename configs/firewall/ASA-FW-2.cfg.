! ==========================================================
! Device: FW-2
! Role: Internet Edge Firewall 2
! Project: Three-Tier Enterprise Network Architecture
! Platform: Cisco ASA 9.6(1) - Packet Tracer
! Configuration: Sanitized for public GitHub repository
! ==========================================================
!
ASA Version 9.6(1)
!
hostname FW-2
names
!
interface GigabitEthernet1/1
 description OUTSIDE-LINK-TO-ISP-G0/1
 nameif outside
 security-level 0
 ip address 200.0.2.2 255.255.255.252
!
interface GigabitEthernet1/2
 description LINK-TO-CORE-2
 nameif inside-core2
 security-level 100
 ip address 10.0.1.5 255.255.255.252
!
interface GigabitEthernet1/3
 description LINK-TO-CORE-1
 nameif inside-core1
 security-level 100
 ip address 10.0.1.14 255.255.255.252
!
interface GigabitEthernet1/4
 no nameif
 no security-level
 no ip address
 shutdown
!
interface GigabitEthernet1/5
 no nameif
 no security-level
 no ip address
 shutdown
!
interface GigabitEthernet1/6
 no nameif
 no security-level
 no ip address
 shutdown
!
interface GigabitEthernet1/7
 no nameif
 no security-level
 no ip address
 shutdown
!
interface GigabitEthernet1/8
 no nameif
 no security-level
 no ip address
 shutdown
!
interface Management1/1
 management-only
 no nameif
 no security-level
 no ip address
 shutdown
!
object network INTERNAL-NETWORKS
 subnet 10.0.0.0 255.0.0.0
 nat (any,outside) dynamic interface
!
route outside 0.0.0.0 0.0.0.0 200.0.2.1 1
!
access-list OUTSIDE-IN extended permit icmp host 200.0.2.1 any
access-list OUTSIDE-IN extended permit icmp any any echo-reply
access-list OUTSIDE-IN extended permit icmp any any unreachable
!
!
access-group OUTSIDE-IN in interface outside
!
!
class-map inspection_default
 match default-inspection-traffic
!
policy-map type inspect dns preset_dns_map
 parameters
  message-length maximum 512
policy-map global_policy
 class inspection_default
  inspect dns preset_dns_map
  inspect ftp 
  inspect tftp 
!
service-policy global_policy global
!
telnet timeout 5
ssh timeout 5
!
!
!
!
router ospf 1
 router-id 2.2.2.2
 log-adjacency-changes
 network 10.0.1.4 255.255.255.252 area 0
 network 10.0.1.12 255.255.255.252 area 0
 default-information originate
!
